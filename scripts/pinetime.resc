:name: PineTime
:description: Emulates a PineTime smartwatch; load firmware images into sysbus after including this script.
# SPDX-License-Identifier: GPL-3.0-or-later

$name?="pinetime"
$root?=$ORIGIN/..

include $root/peripherals/NRF52832_NVMC.cs
include $root/peripherals/NRF52832_GPIO.cs
include $root/peripherals/NRF52832_GPIOTE.cs
include $root/peripherals/NRF52832_PowerClock.cs
include $root/peripherals/NRF52832_Watchdog.cs
include $root/peripherals/NRF52832_RTC.cs
include $root/peripherals/NRF52832_TIMER.cs
include $root/peripherals/PineTime_XT25F32B.cs
include $root/peripherals/NRF52832_SerialInterface.cs
include $root/peripherals/NRF52832_SAADC.cs
include $root/peripherals/NRF52832_TEMP.cs
include $root/peripherals/NRF52832_CCM_AAR.cs
include $root/peripherals/NRF52832_RADIO.cs
include $root/peripherals/NRF52832_QDEC.cs
include $root/peripherals/NRF52832_COMP_LPCOMP.cs
include $root/peripherals/NRF52832_PWM.cs
include $root/peripherals/NRF52832_MWU.cs
include $root/peripherals/PineTime_ST7789.cs
include $root/peripherals/PineTime_SideButton.cs
include $root/peripherals/PineTime_CST816S.cs
include $root/peripherals/PineTime_BMA42x.cs
include $root/peripherals/PineTime_HRS3300.cs
include $root/peripherals/PineTime_Battery.cs

# A 1 ms quantum keeps an idle watch faster than real time; the Bluetooth bridge sets a shorter one.
emulation SetGlobalQuantum "0.001"

mach create $name
machine LoadPlatformDescription $root/platform/pinetime.repl
sysbus ApplySVD $root/platform/nrf52.svd

# Parts wired to pins learn the starting level of each pin.
gpio0 AnnounceAllLevels

# The CPU changes flash only through the flash controller, as on the chip.
nvmc GuardFlashWrites

# Flash and UICR start erased, as on a new chip.
flash SetRange 0 0x80000 0xFF
uicr SetRange 0 0x1000 0xFF
externalFlashMemory SetRange 0 0x400000 0xFF

# FICR: page size and count, the device address, and the part, RAM and flash size.
ficr SetRange 0 0x1000 0xFF
sysbus WriteDoubleWord 0x10000010 0x1000
sysbus WriteDoubleWord 0x10000014 0x80
sysbus WriteDoubleWord 0x10000060 0x50494E45
sysbus WriteDoubleWord 0x10000064 0x54494D45
sysbus WriteDoubleWord 0x100000A0 0x1
sysbus WriteDoubleWord 0x100000A4 0x0A1B2C3D
sysbus WriteDoubleWord 0x100000A8 0xC0DE
sysbus WriteDoubleWord 0x10000100 0x52832
sysbus WriteDoubleWord 0x10000104 0x41414530
sysbus WriteDoubleWord 0x10000108 0x2000
sysbus WriteDoubleWord 0x1000010C 0x40
sysbus WriteDoubleWord 0x10000110 0x200
sysbus WriteDoubleWord 0x10000130 0x6
sysbus WriteDoubleWord 0x10000134 0x5

# The part and revision numbers older Nordic SDKs read to pick errata workarounds.
sysbus WriteDoubleWord 0xF0000FE0 0x06
sysbus WriteDoubleWord 0xF0000FE4 0x00
sysbus WriteDoubleWord 0xF0000FE8 0x50
sysbus WriteDoubleWord 0xF0000FEC 0x00
