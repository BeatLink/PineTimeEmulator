:name: PineTime window
:description: Builds the PineTime and adds the bridge that shares its outputs with the desktop window (frontend/).

$root?=$ORIGIN/..

include $root/scripts/pinetime.resc

# The bridge uses the board's part types, so it compiles after them.
include $root/peripherals/PineTime_WindowBridge.cs

machine LoadPlatformDescriptionFromString "windowBridge: Miscellaneous.PineTime_WindowBridge @ gpio0 { motor: vibrationMotor; button: sideButton; battery: battery; accelerometer: accelerometer }"
