:name: PineTime Bluetooth bridge
:description: Adds an nRF52840 running Zephyr's HCI-UART controller on the PineTime's radio medium and exposes its HCI on a host pseudo-terminal. Include after scripts/pinetime.resc; set $hci_pty first to choose the path.
# SPDX-License-Identifier: GPL-3.0-or-later

# Monitor variables belong to the selected machine, so these are set with none selected.
mach clear
$root?=$ORIGIN/..
$hci_pty?="/tmp/pinetime-hci"
$hci_controller?=@https://dl.antmicro.com/projects/renode/nrf52840dk--zephyr-ble_hci_uart.elf-s_2437336-4bf9cccb70ca95fb12667896eec3f777f39f90ee

include $root/peripherals/NRF52832_RADIO.cs
include $root/peripherals/NRF52832_CCM_AAR.cs
include $root/peripherals/NRF52832_TIMER.cs
include $root/peripherals/NRF52832_RTC.cs

# The watch and the controller share one Bluetooth LE medium.
emulation CreateBLEMedium "air"
mach set "pinetime"
connector Connect sysbus.radio air

# The controller's UART1 carries H4 HCI to the host through a pseudo-terminal.
mach create "bluetooth_bridge"
machine LoadPlatformDescription $root/platform/bluetooth-bridge.repl
connector Connect sysbus.radio air
emulation CreateUartPtyTerminal "hci_terminal" $hci_pty true
connector Connect sysbus.uart1 hci_terminal
sysbus LoadELF $hci_controller

# Short quanta keep both radios in step, as Renode's own BLE examples do.
emulation SetGlobalQuantum "0.00001"

mach set "pinetime"
