// SPDX-License-Identifier: GPL-3.0-or-later
// The PineTime: an nRF52832 plus the parts wired to it, on the pins of the PineTime schematic.

using "nrf52832.repl"

// ============================================================================
// Shared serial blocks: instance 0 at 0x40003000 and instance 1 at 0x40004000
// ============================================================================

serial0: SPI.NRF52832_SerialInterface @ sysbus 0x40003000
    -> nvic@3

serial1: SPI.NRF52832_SerialInterface @ sysbus 0x40004000
    -> nvic@4

// ============================================================================
// SPI bus: the screen (CS P0.25) and the 4 MB external flash (CS P0.05)
// ============================================================================

spiBus: SPI.SPIMultiplexer @ serial0
    init:
        SetActiveLow 25
        SetActiveLow 5

lcd: Video.PineTime_ST7789 @ spiBus 25

externalFlashMemory: Memory.MappedMemory @ sysbus 0x60000000
    size: 0x400000

externalFlash: SPI.PineTime_XT25F32B @ spiBus 5
    memory: externalFlashMemory

// ============================================================================
// I2C bus: touch panel (INT P0.28, RESET P0.10), accelerometer (INT P0.08) and heart rate sensor
// ============================================================================

touch: Sensors.PineTime_CST816S @ serial1 0x15
    IRQ -> gpio0@28

// Watches ship with either a BMA421 or a BMA425.
accelerometer: Sensors.PineTime_BMA42x @ serial1 0x18
    model: "BMA425"
    INT1 -> gpio0@8

heartRateSensor: Sensors.PineTime_HRS3300 @ serial1 0x44


// ============================================================================
// Button, motor and power
// ============================================================================

sideButton: Miscellaneous.PineTime_SideButton @ gpio0
    port: gpio0

battery: Miscellaneous.PineTime_Battery @ gpio0
    saadc: saadc
    port: gpio0

// The motor runs while P0.16 is low.
vibrationMotor: Miscellaneous.LED @ gpio0
    invert: true

// ============================================================================
// Pin wiring
// ============================================================================

// Board pull-ups hold the chip selects (P0.05 flash, P0.25 screen) and the charger lines (P0.12, P0.19) high while undriven.
gpio0:
    boardPullUps: 0x02081020
    5 -> spiBus@5
    10 -> touch@0
    14 -> lcd@2
    15 -> sideButton@0
    16 -> vibrationMotor@0
    18 -> lcd@0
    22 -> lcd@3
    23 -> lcd@4
    25 -> spiBus@25
    26 -> lcd@1
